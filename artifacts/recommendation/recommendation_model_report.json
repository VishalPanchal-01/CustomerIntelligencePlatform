            "name": "Item-Based Collaborative Filtering",
            "approach": "Customer-item sparse matrix with item-item cosine similarity"
        },
        {
            "name": "Matrix Factorization",
            "approach": "TruncatedSVD over the implicit customer-product interaction matrix"
